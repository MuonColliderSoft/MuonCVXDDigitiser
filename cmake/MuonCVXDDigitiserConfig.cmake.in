set(@PROJECT_NAME@_VERSION @MuonCVXDDigitiser_VERSION@)

@PACKAGE_INIT@

# modify if other PATH_VARS are used
set_and_check(@PROJECT_NAME@_LIB_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")

include(CMakeFindDependencyMacro)
# modify to reflect dependencies
find_dependency(EDM4HEP)
find_dependency(DD4hep COMPONENTS DDRec)
find_dependency(CLHEP)
find_dependency(GSL)

if (NOT TARGET @PROJECT_NAME@::MuonCVXDDigitiserCore)
  include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
endif()

check_required_components(@PROJECT_NAME@)
